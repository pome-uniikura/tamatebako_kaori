---
import Base from '../layouts/Base.astro';
import { certs, steps, url, certSummaries, getLessonKeys, displayName } from '../lib/data';

const summaries = certSummaries(await getLessonKeys());
const hoursOf = (ids: string[]) => certs.filter((c) => ids.includes(c.id)).reduce((sum, c) => sum + (c.study?.hours ?? 0), 0);
const stepOf = Object.fromEntries(certs.map((c) => [c.id, c.step]));
---

<Base title="WEBテスト対策" nav="home">
  <header class="page-head">
    <h1>WEB テスト対策</h1>
    <p class="muted">玉手箱と TG-WEB（従来型・新型）の対策サイトです。受けるテストが決まっていれば、その科目から始めましょう。決まっていなければ「はじめに」でテストの見分け方から確認できます。</p>
  </header>

  <section class="card focus" aria-labelledby="focus-title" id="focus" hidden>
    <p class="eyebrow" id="focus-step"></p>
    <h2 id="focus-title" class="focus-title"></h2>
    <div class="focus-progress">
      <div class="progress thick" aria-hidden="true"><span id="focus-bar"></span></div>
      <span class="focus-percent" id="focus-percent"></span>
    </div>
    <p class="small muted focus-meta" id="focus-meta"></p>
    <p class="small focus-pace" id="focus-pace"></p>
    <div class="btn-row stack" id="focus-actions"></div>
  </section>

  <section class="card done-all" id="done-all" hidden>
    <h2>すべての科目の受検が終わりました 🎉</h2>
    <p class="muted">お疲れさまでした。復習や用語集はいつでも使えます。</p>
  </section>

  <section aria-label="今日の学習" class="today">
    <div class="stats">
      <div class="stat">
        <span class="stat-label">今日の学習</span>
        <span class="stat-value"><span id="today-count">0</span><small>件</small></span>
      </div>
      <div class="stat">
        <span class="stat-label">連続学習</span>
        <span class="stat-value"><span id="streak">0</span><small>日</small></span>
      </div>
      <a class="stat stat-link" href={url('review/')}>
        <span class="stat-label">復習待ち</span>
        <span class="stat-value"><span id="review-total">0</span><small>問</small></span>
      </a>
    </div>
    <p class="small muted today-hint" id="today-hint"></p>
  </section>

  <h2 class="section-title">テストと科目</h2>
  <ol class="steps">
    {
      steps.map((step) => {
        const list = certs.filter((c) => c.step === step.id);
        return (
          <li class="step" style={`--step-color: var(--step-${step.id})`}>
            <div class="step-head">
              <h3>{step.title}</h3>
              <span class="small muted step-hours">約 {hoursOf(list.map((c) => c.id))} 時間</span>
            </div>
            <p class="small muted step-sub">{step.subtitle}</p>
            <ul class="list">
              {list.map((c) => (
                <li class="row-link cert-row" data-cert={c.id}>
                  <span class="cert-status" data-status aria-hidden="true" />
                  <div class="cert-main">
                    <a class="stretched cert-name" href={url(`certs/${c.id}/`)}>
                      {displayName(c)}
                    </a>
                    <span class="tag tag-accent" data-current hidden>
                      学習中
                    </span>
                    <span class="tag tag-success" data-passed hidden>
                      受検済み
                    </span>
                    {c.status !== 'ready' && <span class="tag">概要のみ</span>}
                    <p class="small muted cert-sub">
                      {c.exam.questions !== null && c.exam.minutes !== null && <span>{c.exam.questions} 問・{c.exam.minutes} 分 ・ </span>}
                      {c.exam.format === 'single' && <span>{c.domains.length} 形式から 1 つ ・ </span>}
                      {c.study && <span>約 {c.study.hours} 時間</span>}
                      <span data-target />
                    </p>
                  </div>
                  <div class="cert-progress">
                    <div class="progress" aria-hidden="true">
                      <span data-bar />
                    </div>
                    <span class="small cert-percent" data-percent>
                      0%
                    </span>
                  </div>
                  <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m9 6 6 6-6 6" />
                  </svg>
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ol>

  <script type="application/json" id="cert-data" set:html={JSON.stringify(summaries)} />
  <script type="application/json" id="cert-steps" set:html={JSON.stringify(stepOf)} />
  <script type="application/json" id="step-titles" set:html={JSON.stringify(Object.fromEntries(steps.map((s) => [s.id, s.title])))} />
  <script>
    import type { CertSummary } from '../lib/data';
    import { getReadingPos, loadProgress } from '../lib/storage';
    import { certProgress, daysLabel, daysUntil, nextAction, paceText, readJson, studyStreak } from '../lib/progress';

    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const summaries = readJson<CertSummary[]>('cert-data');
    const stepOf = readJson<Record<string, number>>('cert-steps');
    const stepTitles = readJson<Record<string, string>>('step-titles');
    const data = loadProgress();
    const targetOf = (c: CertSummary) => data.plans[c.id]?.targetDate ?? c.suggestedTarget ?? null;
    const $ = (id: string) => document.getElementById(id)!;

    // いま取り組む科目: 最後に学習した科目（受検済みを除く）。まだ何もしていなければ最初の科目
    const lastStudied = (c: CertSummary) => {
      const times = [
        ...Object.entries(data.lessons)
          .filter(([k]) => k.startsWith(`${c.id}/`))
          .map(([, v]) => v),
        ...c.questions.map((q) => data.questions[q.id]?.lastAt).filter((v): v is string => Boolean(v)),
      ];
      return times.sort().pop() ?? '';
    };
    const open = summaries.filter((c) => !data.plans[c.id]?.passedDate);
    const ranked = open.map((c) => ({ c, t: lastStudied(c) })).sort((a, b) => b.t.localeCompare(a.t));
    const current = ranked[0]?.t ? ranked[0].c : open[0];

    for (const c of summaries) {
      const row = document.querySelector<HTMLElement>(`[data-cert="${c.id}"]`);
      if (!row) continue;
      const p = certProgress(c, data);
      const passed = Boolean(data.plans[c.id]?.passedDate);
      const percent = passed ? 100 : p.percent;
      row.querySelector<HTMLElement>('[data-bar]')!.style.width = `${percent}%`;
      row.querySelector('[data-percent]')!.textContent = `${percent}%`;
      row.querySelector<HTMLElement>('[data-passed]')!.hidden = !passed;
      row.querySelector<HTMLElement>('[data-current]')!.hidden = c !== current;
      row.dataset.state = passed ? 'passed' : c === current ? 'current' : percent > 0 ? 'started' : 'todo';
      const target = targetOf(c);
      if (target && !passed) {
        row.querySelector('[data-target]')!.textContent = ` ・ 目標 ${target.slice(5).replace('-', '/')}（${daysLabel(daysUntil(target))}）`;
      }
    }

    if (!current) {
      $('done-all').hidden = false;
    } else {
      const p = certProgress(current, data);
      const target = targetOf(current);
      $('focus').hidden = false;
      $('focus').style.setProperty('--step-color', `var(--step-${stepOf[current.id]})`);
      $('focus-step').textContent = `いま取り組む科目 ・ ${stepTitles[stepOf[current.id]] ?? ''}`;
      $('focus-title').textContent = current.name;
      $('focus-bar').style.width = `${p.percent}%`;
      $('focus-percent').textContent = `${p.percent}%`;
      const meta = [`レッスン ${p.lessonsDone}/${p.lessonsTotal}`, `練習の目標 ${p.mastered}/${p.questionsTotal} 問`];
      if (target) meta.unshift(`受験目標 ${target}（${daysLabel(daysUntil(target))}）`);
      $('focus-meta').textContent = meta.join(' ・ ');
      $('focus-pace').textContent = target ? paceText(current.studyHours, p.percent, daysUntil(target)) : '';

      const actions: string[] = [];
      // 読みかけのレッスンがあれば、続きを最優先にする
      const reading = current.lessonDomains
        .filter((d) => !data.lessons[`${current.id}/${d}`])
        .map((d) => ({ d, pos: getReadingPos(`${current.id}/${d}`) }))
        .find((r) => r.pos);
      const next = nextAction(current, data, base);
      if (reading) {
        const name = current.domains.find((d) => d.id === reading.d)?.name ?? reading.d;
        actions.push(`<a class="btn btn-primary" href="${base}/certs/${current.id}/${reading.d}/#${reading.pos!.heading}">続きを読む: ${name}</a>`);
      } else if (next) {
        actions.push(`<a class="btn btn-primary" href="${next.href}">${next.label}</a>`);
      }
      actions.push(`<a class="btn" href="${base}/certs/${current.id}/">科目のページを開く</a>`);
      $('focus-actions').innerHTML = actions.join('');
    }

    // 今日の学習
    const { streak, today } = studyStreak(data.activity);
    const reviewTotal = Object.values(data.questions).filter((q) => q.inReview).length;
    $('today-count').textContent = String(today);
    $('streak').textContent = String(streak);
    $('review-total').textContent = String(reviewTotal);
    $('today-hint').textContent =
      today > 0
        ? '今日も学習できました。この調子で続けましょう。'
        : streak > 0
          ? `連続 ${streak} 日です。今日も 1 問解くと記録が伸びます。`
          : '問題を解いたりレッスンを読み終えたりすると、ここに記録されます。';
  </script>
</Base>

<style>
  .page-head {
    margin-bottom: 20px;
  }
  .page-head p {
    margin: 0;
  }
  .focus {
    border-top: 4px solid var(--step-color, var(--accent));
    margin-bottom: 12px;
  }
  .focus-title {
    font-size: 1.35rem;
    margin: 0 0 12px;
  }
  .focus-progress {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .focus-progress .progress {
    flex: 1;
  }
  .focus-progress .progress > span {
    background: var(--step-color, var(--accent));
  }
  .focus-percent {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    min-width: 3em;
    text-align: right;
  }
  .focus-meta {
    margin: 8px 0 0;
  }
  .focus-pace {
    margin: 2px 0 16px;
  }
  .focus-pace:empty {
    margin-bottom: 12px;
  }
  .done-all {
    margin-bottom: 12px;
  }
  .done-all h2 {
    margin-top: 0;
  }
  .today .stats {
    grid-template-columns: repeat(3, 1fr);
  }
  .stat-link {
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .stat-link:hover {
    background: var(--accent-soft);
    color: inherit;
  }
  .today-hint {
    margin: 6px 2px 0;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 28px;
  }
  .step-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .step-head h3 {
    margin: 0;
    font-size: 1.05rem;
    padding-left: 10px;
    border-left: 4px solid var(--step-color);
  }
  .step-hours {
    margin-left: auto;
    white-space: nowrap;
  }
  .step-sub {
    margin: 0 0 8px;
  }
  .step-no {
    background: color-mix(in srgb, var(--step-color) 14%, transparent);
    color: var(--step-color);
    font-weight: 700;
    font-size: 0.72rem;
    padding: 2px 10px;
    border-radius: 999px;
    white-space: nowrap;
    letter-spacing: 0.04em;
  }
  .cert-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
  }
  .cert-status {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 2px solid var(--border-strong);
  }
  .cert-row[data-state='started'] .cert-status,
  .cert-row[data-state='current'] .cert-status {
    border-color: var(--step-color);
    background: conic-gradient(var(--step-color) 50%, transparent 0);
  }
  .cert-row[data-state='passed'] .cert-status {
    border-color: var(--success);
    background: var(--success);
  }
  .cert-main {
    min-width: 0;
  }
  .cert-name {
    font-weight: 700;
    margin-right: 6px;
  }
  .cert-sub {
    margin: 2px 0 0;
  }
  .cert-progress {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 140px;
  }
  .cert-progress .progress {
    flex: 1;
  }
  .cert-progress .progress > span {
    background: var(--step-color);
  }
  .cert-row[data-state='passed'] .cert-progress .progress > span {
    background: var(--success);
  }
  .cert-percent {
    font-variant-numeric: tabular-nums;
    min-width: 2.8em;
    text-align: right;
    color: var(--text-muted);
  }
  @media (max-width: 599px) {
    .cert-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 4px 12px;
    }
    .cert-progress {
      grid-column: 2;
      grid-row: 2;
      width: auto;
    }
    .chevron {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }
</style>
