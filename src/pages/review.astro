---
import Base from '../layouts/Base.astro';
import { certs, displayName, getQuestions, url } from '../lib/data';
import '../styles/quiz.css';

// 問題 ID の先頭（例: tbk-）で科目がわかるので、問題データは必要な科目の分だけ読み込む
const payload = {
  certs: certs
    .filter((c) => getQuestions(c.id).length > 0)
    .map((c) => ({
      id: c.id,
      name: displayName(c),
      prefix: getQuestions(c.id)[0].id.split('-')[0],
      dataUrl: url(`data/${c.id}.json`),
      // 形式 ID は科目をまたぐと重複しうるので、科目 ID を付けて一意にする
      domains: c.domains.map((d) => ({ id: `${c.id}:${d.id}`, name: d.name, weight: d.weight })),
    })),
};
---

<Base title="復習" nav="review">
  <div id="intro">
    <h1>復習</h1>
    <p class="muted">間違えた問題が自動で集まります。<strong>2 回続けて正解</strong>すると、このリストから外れます。</p>
  </div>

  <section class="card empty" id="empty" hidden>
    <div class="empty-icon" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </div>
    <h2>復習待ちの問題はありません</h2>
    <p class="muted">練習問題や本番形式の演習で間違えた問題が、ここに自動で集まります。</p>
    <div class="btn-row">
      <a class="btn btn-primary" id="empty-cta" href={url()}>ホームへ</a>
    </div>
  </section>

  <section id="picker" hidden>
    <div class="card start">
      <p class="start-count"><strong id="total">0</strong> 問が復習待ちです</p>
      <a class="btn btn-primary" href="?cert=all">すべて復習する</a>
    </div>
    <h2 class="section-title">科目ごとに復習する</h2>
    <ul class="list" id="cert-list"></ul>
  </section>

  <div id="quiz"></div>

  <script type="application/json" id="review-data" set:html={JSON.stringify(payload)} />
  <script>
    import type { Passage, QuizPayload, QuizQuestion } from '../lib/types';
    import { loadProgress } from '../lib/storage';
    import { readJson } from '../lib/progress';
    import { runQuiz, type DomainInfo } from '../lib/quiz-runner';

    interface CertRef {
      id: string;
      name: string;
      prefix: string;
      dataUrl: string;
      domains: DomainInfo[];
    }
    const data = readJson<{ certs: CertRef[] }>('review-data');
    const progress = loadProgress();
    const reviewIds = Object.entries(progress.questions)
      .filter(([, s]) => s.inReview)
      .map(([id]) => id);
    const certOf = (id: string) => data.certs.find((c) => id.startsWith(`${c.prefix}-`));
    const home = import.meta.env.BASE_URL;
    const reviewHref = `${home}review/`;
    const $ = (id: string) => document.getElementById(id)!;
    const certParam = new URLSearchParams(location.search).get('cert');
    const counts = new Map<string, number>();
    for (const id of reviewIds) {
      const c = certOf(id);
      if (c) counts.set(c.id, (counts.get(c.id) ?? 0) + 1);
    }
    const total = [...counts.values()].reduce((a, b) => a + b, 0);

    async function startReview() {
      const targets = data.certs.filter((c) => counts.has(c.id) && (certParam === 'all' || certParam === c.id));
      $('intro').hidden = true;
      $('quiz').innerHTML = '<p class="muted">読み込み中…</p>';
      const questions: QuizQuestion[] = [];
      const passages: Record<string, Passage> = {};
      try {
        for (const c of targets) {
          const res = await fetch(c.dataUrl);
          if (!res.ok) throw new Error(String(res.status));
          const payload = (await res.json()) as QuizPayload;
          Object.assign(passages, payload.passages);
          for (const q of payload.questions) {
            if (progress.questions[q.id]?.inReview) questions.push({ ...q, domain: `${c.id}:${q.domain}` });
          }
        }
      } catch {
        $('quiz').innerHTML = '<div class="card"><p>問題を読み込めませんでした。電波の良いところでもう一度開いてください。</p></div>';
        return;
      }
      const name = data.certs.find((c) => c.id === certParam)?.name;
      runQuiz({
        root: $('quiz'),
        mode: 'practice',
        questions,
        passages,
        domains: data.certs.flatMap((c) => c.domains),
        title: name ? `復習: ${name}（${questions.length} 問）` : `復習（${questions.length} 問）`,
        backHref: reviewHref,
        backLabel: '復習の一覧へ',
      });
    }

    if (!total) {
      $('empty').hidden = false;
    } else if (certParam) {
      startReview();
    } else {
      $('picker').hidden = false;
      $('total').textContent = String(total);
      $('cert-list').innerHTML = data.certs
        .filter((c) => counts.has(c.id))
        .map(
          (c) => `<li class="row-link review-row">
            <a class="stretched" href="?cert=${c.id}">${c.name}</a>
            <span class="tag tag-danger">${counts.get(c.id)} 問</span>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </li>`,
        )
        .join('');
    }
  </script>
</Base>

<style>
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
  }
  .start-count {
    margin: 0;
    font-size: 1.05rem;
  }
  .start-count strong {
    font-size: 1.6rem;
    margin-right: 2px;
  }
  .empty {
    margin-top: 16px;
  }
  #cert-list :global(.review-row) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
  }
  #cert-list :global(.review-row .stretched) {
    flex: 1;
    font-weight: 600;
  }
</style>
